{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run the app (opens /ui)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run.ps1",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Format",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "format", "."],
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "check", ".", "--fix"],
      "problemMatcher": []
    },
    {
      "label": "Lint and format",
      "dependsOn": ["Format", "Lint"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Reproduce the pipeline (dvc repro)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "dvc", "repro"],
      "problemMatcher": []
    },
    {
      "label": "MLflow UI",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "mlflow", "ui"],
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    }
  ]
}
